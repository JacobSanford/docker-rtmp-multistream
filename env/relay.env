ARCHIVE_PATH=
ARCHIVE_SUFFIX=flv

TWITCH_KEY=
TWITCH_PARTNER=FALSE
# Set TWITCH_PARTNER=TRUE if you have Twitch Partner transcoding services
# Partner mode uses simple relay (passthrough) - the following transformer variables are ignored
# Non-partner mode (default) uses FFmpeg transcoding with the settings below
TWITCH_AUDIO_BITRATE=160k
TWITCH_CODEC=libx264
TWITCH_ENDPOINT=jfk
TWITCH_FFMPEG_THREADS=0
TWITCH_FPS=60
TWITCH_HEIGHT=720
TWITCH_KBITS_PER_VIDEO_FRAME=75
TWITCH_X264_PRESET=medium

YOUTUBE_KEY=

NGINX_ERROR_LOG_LEVEL=error
